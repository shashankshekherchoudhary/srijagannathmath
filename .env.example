# ─── Sri Jagannath Math — Environment Variables ───
# Copy this file to .env and fill in your values.
# NEVER commit .env with real secrets to version control.

# ─── Django Core ───
DEBUG=False
SECRET_KEY=generate-a-50-char-random-string-here

# Comma-separated list of your production domain(s)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ─── Database ───
# For PostgreSQL (recommended for production):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── CSRF ───
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─── SSL ───
# Set to False if your proxy does NOT terminate SSL
# SECURE_SSL_REDIRECT=True

# ─── Cloudinary Media Storage (optional) ───
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Or use individual keys:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Data Directory (optional — for Railway Volume / Docker mount) ───
# DATA_DIR=/data
